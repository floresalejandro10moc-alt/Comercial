<UserControl x:Class="SDV.UI.Views.GestionNovedadesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F4F7F6" FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="HeaderStyleConsistente" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#95A5A6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,15"/>
        </Style>

        <Style x:Key="GridActionButton" TargetType="Button">
            <Setter Property="Background" Value="#F4F7F6"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WideActionButton" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" BorderThickness="0">
        <Grid Margin="30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="Talento Humano - Configuración" FontSize="14" Foreground="#777" Margin="0,0,0,5"/>
                <TextBlock Text="Gestión de Beneficios y Descuentos" FontSize="28" FontWeight="Bold" Foreground="#2C3E50"/>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#E0E0E0" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="➕ NUEVO BENEFICIO" FontWeight="Bold" FontSize="15" Foreground="#27AE60" Margin="0,0,0,15"/>
                            <TextBlock Text="Descripción:" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding DescripcionBono, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="8,0"/>
                            <TextBlock Text="Valor Sugerido ($):" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ValorBono, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="8,0"/>
                            <Button Content="GUARDAR BENEFICIO" Command="{Binding GuardarBonoCommand}" Background="#27AE60" Style="{StaticResource WideActionButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="20" Height="42" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDC3C7" FontSize="16"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="Buscar beneficio..." VerticalAlignment="Center" Foreground="#BDBDBD" IsHitTestVisible="False" Margin="5,0,0,0"
                                           Visibility="{Binding Text.IsEmpty, ElementName=txtBusqBono, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox x:Name="txtBusqBono" Text="{Binding FiltroBusquedaBonos, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="5">
                        <Border.Effect>
                            <DropShadowEffect Color="#E0E0E0" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding BonosLista}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                  GridLinesVisibility="None" HeadersVisibility="Column" Background="White" BorderThickness="0" 
                                  RowHeight="55" Height="350" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" HeaderStyle="{StaticResource HeaderStyleConsistente}"/>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Valor, StringFormat=C2}" Width="95" FontWeight="Bold" Foreground="#27AE60" HeaderStyle="{StaticResource HeaderStyleConsistente}"/>
                                <DataGridTemplateColumn Width="60" HeaderStyle="{StaticResource HeaderStyleConsistente}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" Style="{StaticResource GridActionButton}" Command="{Binding DataContext.EliminarBonoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="#E74C3C"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <Border Background="White" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                        <Border.Effect>
                            <DropShadowEffect Color="#E0E0E0" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="➖ NUEVO DESCUENTO" FontWeight="Bold" FontSize="15" Foreground="#C0392B" Margin="0,0,0,15"/>
                            <TextBlock Text="Descripción:" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding DescripcionDesc, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,15" VerticalContentAlignment="Center" Padding="8,0"/>
                            <TextBlock Text="Valor Sugerido ($):" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding ValorDesc, UpdateSourceTrigger=PropertyChanged}" Height="35" Margin="0,0,0,20" VerticalContentAlignment="Center" Padding="8,0"/>
                            <Button Content="GUARDAR DESCUENTO" Command="{Binding GuardarDescCommand}" Background="#C0392B" Style="{StaticResource WideActionButton}"/>
                        </StackPanel>
                    </Border>

                    <Border Background="White" CornerRadius="20" Height="42" Margin="0,0,0,15" BorderBrush="#E0E0E0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#BDC3C7" FontSize="16"/>
                            <Grid Grid.Column="1">
                                <TextBlock Text="Buscar descuento..." VerticalAlignment="Center" Foreground="#BDBDBD" IsHitTestVisible="False" Margin="5,0,0,0"
                                           Visibility="{Binding Text.IsEmpty, ElementName=txtBusqDesc, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox x:Name="txtBusqDesc" Text="{Binding FiltroBusquedaDescuentos, UpdateSourceTrigger=PropertyChanged}" 
                                         BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" Padding="5,0"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Background="White" CornerRadius="10" Padding="5">
                        <Border.Effect>
                            <DropShadowEffect Color="#E0E0E0" BlurRadius="15" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <DataGrid ItemsSource="{Binding DescuentosLista}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" 
                                  GridLinesVisibility="None" HeadersVisibility="Column" Background="White" BorderThickness="0" 
                                  RowHeight="55" Height="350" VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="DESCRIPCIÓN" Binding="{Binding Descripcion}" Width="*" HeaderStyle="{StaticResource HeaderStyleConsistente}"/>
                                <DataGridTextColumn Header="VALOR" Binding="{Binding Valor, StringFormat=C2}" Width="95" FontWeight="Bold" Foreground="#C0392B" HeaderStyle="{StaticResource HeaderStyleConsistente}"/>
                                <DataGridTemplateColumn Width="60" HeaderStyle="{StaticResource HeaderStyleConsistente}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" Style="{StaticResource GridActionButton}" Command="{Binding DataContext.EliminarDescCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Foreground="#E74C3C"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>