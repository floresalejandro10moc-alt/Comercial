<Window x:Class="SDV.UI.Views.LoginView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Acceso al Sistema SDV" Height="550" Width="850"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        Background="Transparent" AllowsTransparency="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <Style x:Key="ModernInputStyle" TargetType="Border">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EFF6FF"/>
                    <Setter Property="BorderBrush" Value="#00D9A5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Background="White" CornerRadius="20" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.25" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1D23" CornerRadius="20,0,0,20">
                <Grid>
                    <Ellipse Width="300" Height="300" Fill="#00D9A5" Opacity="0.03" Margin="-100,-100,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <Ellipse Width="200" Height="200" Fill="#00D9A5" Opacity="0.05" Margin="0,0,-50,-50" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Grid HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Ellipse Width="80" Height="80" Stroke="#00D9A5" StrokeThickness="3"/>
                            <Ellipse Width="60" Height="60" Fill="#00D9A5" Opacity="0.2"/>
                            <TextBlock Text="SDV" Foreground="White" FontWeight="Bold" FontSize="28" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="SISTEMA COMERCIAL" Foreground="White" FontSize="18" FontWeight="SemiBold" 
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Gestión Integral &amp; Nómina" Foreground="#9CA3AF" FontSize="12" 
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>

                        <Border Background="#2D3748" CornerRadius="15" Padding="15,5" Margin="0,40,0,0" HorizontalAlignment="Center">
                            <TextBlock Text="v.1.3.0 Release" Foreground="#00D9A5" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="© 2025 SDV Corp." Foreground="#4B5563" FontSize="10" 
                               VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Button Click="BtnSalir_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20"
                        Width="30" Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <TextBlock Text="✕" Foreground="#9CA3AF" FontSize="16"/>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel VerticalAlignment="Center" Margin="60,0">
                    <TextBlock Text="Bienvenido de nuevo" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="Ingresa tus credenciales para acceder." FontSize="14" Foreground="#6B7280" Margin="0,5,0,30"/>

                    <TextBlock Text="{Binding MensajeError}" 
                               Visibility="{Binding MensajeError, Converter={StaticResource BoolToVisConverter}}"
                               Foreground="#EF4444" FontWeight="SemiBold" FontSize="13" 
                               TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <TextBlock Text="Usuario" Foreground="#374151" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <Border Style="{StaticResource ModernInputStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="👤" VerticalAlignment="Center" FontSize="16" Foreground="#9CA3AF" Margin="5,0,10,0"/>

                            <TextBox x:Name="txtUser"
                                     Grid.Column="1"
                                     Text="{Binding Usuario, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" FontSize="14"
                                     Foreground="#111827"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Contraseña" Foreground="#374151" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <Border Style="{StaticResource ModernInputStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔒" VerticalAlignment="Center" FontSize="16" Foreground="#9CA3AF" Margin="5,0,10,0"/>
                            <PasswordBox x:Name="txtPass"
                                         Grid.Column="1"
                                         BorderThickness="0" Background="Transparent"
                                         VerticalContentAlignment="Center" FontSize="14"/>
                        </Grid>
                    </Border>

                    <ProgressBar IsIndeterminate="True" Height="2" Background="Transparent" Foreground="#00D9A5" BorderThickness="0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisConverter}}"
                                 Margin="0,15,0,0"/>

                    <Button Click="BtnLogin_Click" Height="50" Margin="0,25,0,0" Cursor="Hand" BorderThickness="0">
                        <Button.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00D9A5" Offset="0"/>
                                <GradientStop Color="#059669" Offset="1"/>
                            </LinearGradientBrush>
                        </Button.Background>
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#059669"/>
                                    </Border.Effect>
                                    <Grid>
                                        <TextBlock Text="INGRESAR AL SISTEMA" Foreground="White" FontWeight="Bold" FontSize="14"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="⏳ Verificando..." Foreground="White" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Content="¿Olvidaste tu contraseña?" 
                            Click="BtnOlvido_Click"
                            Background="Transparent" BorderThickness="0" Foreground="#6B7280" 
                            FontSize="12" Margin="0,15,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>