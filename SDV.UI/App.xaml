<Application x:Class="SDV.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SDV.UI.ViewModels" 
             xmlns:views="clr-namespace:SDV.UI.Views"
             StartupUri="Views/LoginView.xaml">

    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <DataTemplate DataType="{x:Type vm:EmpleadoViewModel}">
            <views:EmpleadoView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:NominaViewModel}">
            <views:GenerarRolView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:LogsViewModel}">
            <views:LogsView />
        </DataTemplate>
        
        <DataTemplate DataType="{x:Type vm:NovedadesViewModel}">
            <views:GestionNovedadesView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:PlanCuentasViewModel}">
            <views:PlanCuentasView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LibroDiarioViewModel}">
            <views:LibroDiarioView />
        </DataTemplate>

        <Style TargetType="Button" x:Key="BtnPrimary">
        </Style>

        <Style x:Key="ModernButton" TargetType="Button" BasedOn="{StaticResource BtnPrimary}"/>

    </Application.Resources>
</Application>